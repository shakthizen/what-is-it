{
  "name": "@shakthizen/what-is-it",
  "version": "1.1.0",
  "description": "Live Project Memory & Interactive Wiki for Vibe Coding",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "type": "module",
  "bin": {
    "what-is-it": "bin/what-is-it.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:cli": "tsup",
    "build:pages": "node scripts/export-static.js",
    "build": "pnpm build:web && pnpm build:cli && pnpm build:pages",
    "test": "tsx --test 'test/**/*.test.ts'",
    "publish:local": "pnpm build && pnpm test && npm publish --access public",
    "start": "node ./bin/what-is-it.js"
  },
  "keywords": [
    "documentation",
    "vibe-coding",
    "agent-skill",
    "wiki",
    "react-flow",
    "cli"
  ],
  "author": "Pearkoder",
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "lucide-react": "^1.41.0",
    "marked": "^18.0.11",
    "open": "^11.0.2",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
